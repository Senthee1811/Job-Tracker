# ==========================================
# Job Tracker Backend Environment Variables
# ==========================================

# Server Port (default: 8000 in dev; Vercel provides PORT dynamically)
PORT=8000
NODE_ENV=development

# Database Connection (MongoDB Atlas URI)
# In production, use mongodb+srv:// with TLS enabled
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jobtracker?retryWrites=true&w=majority

# Security & Authentication
# Strong random secret for signing candidate JWT tokens (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# Frontend Application URL (used for CORS and password reset email links)
# Local: http://localhost:5173
# Production: https://your-job-tracker.vercel.app
FRONTEND_URL=http://localhost:5173

# Vercel Cron Security Secret
# Header: Authorization: Bearer <CRON_SECRET> or query param ?secret=<CRON_SECRET>
CRON_SECRET=your_secure_random_cron_secret_here

# Transactional Email Service (Resend)
# Used for password reset verification emails.
# If omitted or left as placeholder, falls back to logging reset links directly to console.
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Job Tracker <onboarding@resend.dev>

# Google Gemini AI SDK
# Server-side only; required for CV parsing, ATS scoring, match explanation, and tailoring
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Comma-separated cascade fallback models tried automatically if primary model is unavailable or rate-limited
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-live,gemini-3.8-live-extended-thinking

# Cloudinary Storage for Candidate Resumes & Tailored PDFs
# NOTE: If PDF delivery returns HTTP 401 ("deny or ACL failure"), enable "PDF and ZIP files delivery"
# under Cloudinary Console -> Settings -> Security. All CV files are uploaded as authenticated raw assets.
# When omitted, system gracefully falls back to local data URLs in development
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Self-Hosted LaTeX Compiler URL
# If omitted, system uses built-in serverless PDFKit generator with core fonts
LATEX_COMPILER_URL=https://your-latex-compiler.example.com/compile
