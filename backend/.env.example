# Server Configuration
PORT=8000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jobtracker?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars

# Google Gemini AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Cloudinary Storage for Resumes/CVs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
