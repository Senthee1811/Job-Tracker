# Backend API Base URL
# In local development: http://localhost:8000/api
# In production on Vercel:
# - If backend is deployed separately: https://your-backend-domain.vercel.app/api
# - If using single domain rewrites: /api
VITE_API_URL=http://localhost:8000/api
